# ============================================================================
# twilio_service/.env.example  — REMOTE / PRODUCTION template
# Copy to .env on your server and fill in real values.
# This service is FULLY STANDALONE — it never reads from the parent project.
# ============================================================================

# ── Twilio credentials (from https://console.twilio.com) ─────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ── Service database (own PostgreSQL container: twilio-postgres) ──────────────
TWILIO_DB_USER=twilio_user
TWILIO_DB_PASSWORD=strong_production_password
TWILIO_DB_NAME=mhealthDB
POSTGRES_DB_URL=postgresql://twilio_user:strong_production_password@twilio-postgres:5432/mhealthDB

# ── RabbitMQ (own broker container: twilio-rabbitmq) ─────────────────────────
TWILIO_RABBIT_USER=twilio_mq
TWILIO_RABBIT_PASS=strong_mq_password
RABBITMQ_URL=amqp://twilio_mq:strong_mq_password@twilio-rabbitmq:5672//

# ── Public hostname for Twilio webhook callbacks ──────────────────────────────
# Must be publicly reachable by Twilio — no https://, no trailing slash.
# Example: mhealth-twilio.iitgn.ac.in
APP_HOST=your-production-domain.example.com

# ── Uvicorn bind ──────────────────────────────────────────────────────────────
TWILIO_SERVICE_HOST=0.0.0.0
TWILIO_SERVICE_PORT=8002

# ── Call management ───────────────────────────────────────────────────────────
RETRY_DELAY_MINUTES=5
MAX_RETRIES=3

# ── ML microservice (optional) ────────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_TIMEOUT=30

# ── MinIO archive (optional) ─────────────────────────────────────────────────
# If configured, Twilio recordings are copied to this bucket by Celery.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=twilio-recordings

# Optional public URL base for object links. Leave empty to auto-build from endpoint.
MINIO_PUBLIC_BASE_URL=

# ── Admin API JWT ─────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_random_64_hex_chars
ACCESS_TOKEN_EXPIRE_MINUTES=180
